rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic / Healthcheck collection with restrictive schema validation
    match /_connection_tests/{testId} {
      allow read: if true;
      allow create, update: if request.resource.data.testPing == 'OK'
        && request.resource.data.clientApp == 'La3ib Kuwait Web'
        && request.resource.data.timestamp is int;
      allow delete: if isAdmin();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          request.auth.token.email_verified == true && (
            request.auth.token.email == "Khalidalami5555@gmail.com" ||
            request.auth.token.email == "khalidalami5555@gmail.com" ||
            (request.auth.token.email is string && request.auth.token.email.matches('(?i)^khalidalami5555@gmail[.]com$'))
          )
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canUserOrganize() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('canOrganize' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.canOrganize != false;
    }

    // Admin collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == adminId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'admin')
        && (!('email' in request.resource.data) || request.resource.data.email is string);
      allow delete: if isAdmin() && request.auth.uid != adminId;
    }

    // Unique Username Reservations Collection (/usernames/{normalizedUsername})
    match /usernames/{normalizedUsername} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid
        && normalizedUsername.size() >= 3
        && normalizedUsername.size() <= 25
        && normalizedUsername.matches('^[a-z0-9_]+$')
        && request.resource.data.normalized == normalizedUsername
        && request.resource.data.username is string
        && request.resource.data.createdAt is string;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.normalized == normalizedUsername;
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Users Collection (Public Profiles)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) 
        && (request.resource.data.uid == userId || request.resource.data.id == userId)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin())
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isAdmin())
        && (!('canOrganize' in request.resource.data) || request.resource.data.canOrganize == true || isAdmin());
      allow update: if (
        // Profile owner or Admin
        ((isOwner(userId) || isAdmin())
          && (
            isAdmin() || 
            // Regular user cannot escalate to admin or alter administrative restrictions
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role', 'canOrganize']))
          )
        )
        ||
        // Target player follower, following, or friend count update during atomic follow / unfollow, friend accept, or block
        (
          isSignedIn()
          && isValidId(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount', 'followingCount', 'friendCount', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followerCount']) || (request.resource.data.followerCount is number && request.resource.data.followerCount >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followingCount']) || (request.resource.data.followingCount is number && request.resource.data.followingCount >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['friendCount']) || (request.resource.data.friendCount is number && request.resource.data.friendCount >= 0))
        )
      );
      allow delete: if isAdmin() || isOwner(userId);

      // Following Subcollection (/users/{userId}/following/{targetUserId})
      match /following/{targetUserId} {
        allow read: if isSignedIn();
        // Only owner can create a following entry, and cannot self-follow or follow blocked
        allow create: if isOwner(userId)
          && isValidId(targetUserId)
          && targetUserId != userId
          && request.resource.data.userId == targetUserId
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(targetUserId))
          && !exists(/databases/$(database)/documents/users/$(targetUserId)/blocked/$(userId));
        // Owner can unfollow, or the followed target user can remove the following record (e.g. on block)
        allow delete: if isSignedIn() && (isOwner(userId) || request.auth.uid == targetUserId || isAdmin());
      }

      // Followers Subcollection (/users/{userId}/followers/{followerUserId})
      match /followers/{followerUserId} {
        allow read: if isSignedIn();
        // Follower records their follow under target user's followers subcollection, cannot self-follow or follow blocked
        allow create: if isSignedIn()
          && request.auth.uid == followerUserId
          && isValidId(followerUserId)
          && followerUserId != userId
          && request.resource.data.userId == followerUserId
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(followerUserId))
          && !exists(/databases/$(database)/documents/users/$(followerUserId)/blocked/$(userId));
        // Follower can remove their follower entry, or profile owner/admin on account deletion
        allow delete: if isSignedIn() && (request.auth.uid == followerUserId || isOwner(userId) || isAdmin());
      }

      // Blocked Subcollection (/users/{userId}/blocked/{blockedUserId})
      match /blocked/{blockedUserId} {
        allow read: if isOwner(userId) || (isSignedIn() && request.auth.uid == blockedUserId) || isAdmin();
        allow create: if isOwner(userId)
          && isValidId(blockedUserId)
          && blockedUserId != userId
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
          && (!('blockedUserId' in request.resource.data) || request.resource.data.blockedUserId == blockedUserId)
          && (!('id' in request.resource.data) || request.resource.data.id == blockedUserId)
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is string);
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId)
          && isValidId(blockedUserId)
          && blockedUserId != userId;
      }

      // Friends Subcollection (/users/{userId}/friends/{friendUserId})
      match /friends/{friendUserId} {
        allow read: if isSignedIn();
        // Mutual friends record created during atomic acceptance, prevented if blocked
        allow create: if isSignedIn()
          && (request.auth.uid == userId || request.auth.uid == friendUserId)
          && isValidId(friendUserId)
          && friendUserId != userId
          && request.resource.data.userId == friendUserId
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(friendUserId))
          && !exists(/databases/$(database)/documents/users/$(friendUserId)/blocked/$(userId));
        // Either friend party can remove friendship
        allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == friendUserId || isAdmin());
      }

      // Friend Requests Subcollection (/users/{userId}/friendRequests/{requesterUserId})
      match /friendRequests/{requesterUserId} {
        // Read: Recipient (userId) or Requester (requesterUserId)
        allow read: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == requesterUserId);
        // Create: Requester sends request to Recipient, prevented if blocked
        allow create: if isSignedIn()
          && request.auth.uid == requesterUserId
          && isValidId(requesterUserId)
          && requesterUserId != userId
          && request.resource.data.requesterId == requesterUserId
          && request.resource.data.recipientId == userId
          && request.resource.data.status == 'pending'
          && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(requesterUserId))
          && !exists(/databases/$(database)/documents/users/$(requesterUserId)/blocked/$(userId));
        // Delete: Recipient (accept or decline) or Requester (cancel)
        allow delete: if isSignedIn() && (request.auth.uid == userId || request.auth.uid == requesterUserId || isAdmin());
      }

      // Private Account Subcollection (sensitive data like email)
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Real-time Notifications Subcollection (/users/{userId}/notifications/{notificationId})
      match /notifications/{notificationId} {
        // Read: Authenticated user can read only their own notifications
        allow read: if isSignedIn() && request.auth.uid == userId;

        // Update: Authenticated user can only update their own notifications (e.g. marking as read)
        // System and content fields remain immutable
        allow update: if isSignedIn() 
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt', 'updatedAtISO'])
          && request.resource.data.read is bool
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.type == resource.data.type
          && request.resource.data.title == resource.data.title
          && request.resource.data.body == resource.data.body
          && request.resource.data.createdAt == resource.data.createdAt;

        // Delete: Owner or admin can dismiss/delete notifications
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        // Create:
        // 1. Owner can create notification for themselves
        // 2. Verified participant can notify game organizer during join/leave events
        allow create: if isSignedIn() && (
          // Self-notification
          (request.auth.uid == userId && request.resource.data.userId == userId) ||
          // Game-event notification to organizer or current participants
          (
            request.resource.data.userId == userId
            && request.resource.data.actorId == request.auth.uid
            && request.auth.uid != userId
            && request.resource.data.type in ['game_join', 'game_leave', 'game_almost_full', 'game_full', 'chat_message', 'payment_link_request', 'payment_link_provided']
            && request.resource.data.read == false
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
            && request.resource.data.gameId is string
            && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
            && (
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizerId == userId ||
              (
                'organizer' in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data &&
                get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizer.id == userId
              ) ||
              (
                request.resource.data.type == 'payment_link_provided'
                && (
                  get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizerId == request.auth.uid ||
                  (
                    'organizer' in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data &&
                    get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizer.id == request.auth.uid
                  )
                )
              ) ||
              (
                request.resource.data.type == 'chat_message'
                && (
                  userId in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.participantIds ||
                  get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizerId == userId
                )
                && (
                  request.auth.uid in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.participantIds ||
                  get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizerId == request.auth.uid
                )
              )
            )
            && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(userId))
          ) ||
          // Social friend request / friend accept notification
          (
            request.resource.data.userId == userId
            && request.resource.data.actorId == request.auth.uid
            && request.auth.uid != userId
            && request.resource.data.type in ['friend_request', 'friend_request_accepted']
            && request.resource.data.read == false
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
            && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(userId))
          ) ||
          // Game invite notification from organizer to invitee
          (
            request.resource.data.userId == userId
            && request.resource.data.actorId == request.auth.uid
            && request.auth.uid != userId
            && request.resource.data.type == 'game_invite'
            && request.resource.data.read == false
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500
            && !exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(userId))
            && request.resource.data.gameId is string
            && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
            && (
              get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizerId == request.auth.uid ||
              (
                'organizer' in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data &&
                get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.organizer.id == request.auth.uid
              )
            )
          )
        );
      }
    }

    // Games Collection
    match /games/{gameId} {
      allow read: if true; // Public match listings
      allow create: if isSignedIn()
        && request.resource.data.organizerId == request.auth.uid
        && canUserOrganize()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.sport is string
        && request.resource.data.date is string
        && request.resource.data.maxPlayers is number && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 50;
      allow update: if isSignedIn() && (
        isAdmin() ||
        // Organizer can manage their own game (e.g. edit details, cancel, manage attendance)
        (
          resource.data.organizerId == request.auth.uid &&
          request.resource.data.organizerId == request.auth.uid &&
          // Cannot reopen or modify a game that has been cancelled or moderated by an admin
          resource.data.status != 'Cancelled' &&
          (!('moderated' in resource.data) || resource.data.moderated != true) &&
          (!('maxPlayers' in request.resource.data) || (
            request.resource.data.maxPlayers is number &&
            request.resource.data.maxPlayers >= 2 &&
            request.resource.data.maxPlayers >= resource.data.currentPlayers &&
            request.resource.data.maxPlayers <= 50
          )) &&
          (!('pricePerPlayerKWD' in request.resource.data) || (
            request.resource.data.pricePerPlayerKWD is number &&
            request.resource.data.pricePerPlayerKWD >= 0
          )) &&
          (!('totalCourtCostKWD' in request.resource.data) || (
            request.resource.data.totalCourtCostKWD is number &&
            request.resource.data.totalCourtCostKWD >= 0
          ))
        ) ||
        // Joining a game: Authenticated player adding themselves to participants
        (
          // Immutable core game properties
          request.resource.data.organizerId == resource.data.organizerId &&
          request.resource.data.maxPlayers == resource.data.maxPlayers &&
          (!('pricePerPlayerKWD' in resource.data) || request.resource.data.pricePerPlayerKWD == resource.data.pricePerPlayerKWD) &&
          request.resource.data.sport == resource.data.sport &&
          request.resource.data.date == resource.data.date &&
          (!('startTime' in resource.data) || request.resource.data.startTime == resource.data.startTime) &&
          (!('courtName' in resource.data) || request.resource.data.courtName == resource.data.courtName) &&
          // Only affected keys allowed during a player join
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantIds', 'currentPlayers', 'status', 'updatedAt', 'updatedAtISO']) &&
          // Player count validation: increments by exactly 1 and cannot exceed maxPlayers
          request.resource.data.currentPlayers == resource.data.currentPlayers + 1 &&
          request.resource.data.currentPlayers <= resource.data.maxPlayers &&
          // Participants array validation: size increments by 1
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
          // participantIds validation: user adds ONLY their own uid and preserves existing participantIds
          request.resource.data.participantIds is list &&
          request.auth.uid in request.resource.data.participantIds &&
          (!('participantIds' in resource.data) || (
            !(request.auth.uid in resource.data.participantIds) &&
            request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
            request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
          )) &&
          // Cannot join a cancelled match
          resource.data.status != 'Cancelled' &&
          // Status transition validity: either stays Open, or turns Almost Full / Full
          (request.resource.data.status in ['Open', 'Almost Full', 'Full'])
        ) ||
        // Leaving a game: Authenticated player removing ONLY their own entry from participants
        (
          // Immutable core game properties
          request.resource.data.organizerId == resource.data.organizerId &&
          request.resource.data.maxPlayers == resource.data.maxPlayers &&
          (!('pricePerPlayerKWD' in resource.data) || request.resource.data.pricePerPlayerKWD == resource.data.pricePerPlayerKWD) &&
          request.resource.data.sport == resource.data.sport &&
          request.resource.data.date == resource.data.date &&
          (!('startTime' in resource.data) || request.resource.data.startTime == resource.data.startTime) &&
          (!('courtName' in resource.data) || request.resource.data.courtName == resource.data.courtName) &&
          // Only affected keys allowed during a player leave
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'participantIds', 'currentPlayers', 'status', 'updatedAt', 'updatedAtISO']) &&
          // The organizer cannot leave via this player leave operation
          resource.data.organizerId != request.auth.uid &&
          // Player count validation: decrements by exactly 1 and non-negative
          request.resource.data.currentPlayers == resource.data.currentPlayers - 1 &&
          request.resource.data.currentPlayers >= 0 &&
          // Participants array validation: size decrements by 1
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == resource.data.participants.size() - 1 &&
          // participantIds validation: user removes their own uid
          request.resource.data.participantIds is list &&
          !(request.auth.uid in request.resource.data.participantIds) &&
          (!('participantIds' in resource.data) || (
            resource.data.participantIds.hasAll(request.resource.data.participantIds) &&
            request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1
          )) &&
          // Cannot leave an already cancelled match
          resource.data.status != 'Cancelled' &&
          // Status transition validity: stays Open, Almost Full, or transitions from Full to non-Full
          (request.resource.data.status in ['Open', 'Almost Full', 'Full'])
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.organizerId == request.auth.uid);

      // Game Invites Subcollection (/games/{gameId}/invites/{inviteeUserId})
      // Scalable structure: 1 invite doc per invitee. Doc ID is the inviteeUserId.
      match /invites/{inviteeUserId} {
        function getGameData() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }

        // Read: Organizer of the game or the Invitee
        allow read: if isSignedIn() && (
          request.auth.uid == inviteeUserId ||
          getGameData().organizerId == request.auth.uid ||
          (
            'organizer' in getGameData() &&
            ('id' in getGameData().organizer) &&
            getGameData().organizer.id == request.auth.uid
          ) ||
          isAdmin()
        );

        // Create: Only the organizer of the game can send invites
        allow create: if isSignedIn()
          && isValidId(inviteeUserId)
          && request.resource.data.id == inviteeUserId
          && request.resource.data.gameId == gameId
          && request.resource.data.inviterId == request.auth.uid
          && request.resource.data.inviteeId == inviteeUserId
          && request.resource.data.status == 'pending'
          // Cannot invite self
          && inviteeUserId != request.auth.uid
          // Cannot invite blocked player or if player has blocked organizer
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(inviteeUserId))
          && !exists(/databases/$(database)/documents/users/$(inviteeUserId)/blocked/$(request.auth.uid))
          // Verified game organizer
          && (
            getGameData().organizerId == request.auth.uid ||
            (
              'organizer' in getGameData() &&
              ('id' in getGameData().organizer) &&
              getGameData().organizer.id == request.auth.uid
            )
          );

        // Update:
        // 1. Invitee responding (accept or decline)
        // 2. Organizer cancelling pending invite
        allow update: if isSignedIn() && (
          // Invitee accepting or declining
          (
            request.auth.uid == inviteeUserId
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && request.resource.data.status in ['accepted', 'declined']
            && (
              request.resource.data.status == 'declined' ||
              (
                request.resource.data.status == 'accepted'
                && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(resource.data.inviterId))
                && !exists(/databases/$(database)/documents/users/$(resource.data.inviterId)/blocked/$(request.auth.uid))
              )
            )
          ) ||
          // Organizer cancelling
          (
            (
              getGameData().organizerId == request.auth.uid ||
              (
                'organizer' in getGameData() &&
                ('id' in getGameData().organizer) &&
                getGameData().organizer.id == request.auth.uid
              )
            )
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && request.resource.data.status == 'cancelled'
          ) ||
          isAdmin()
        );

        // Delete: Organizer can delete/cancel pending invite, or admin
        allow delete: if isSignedIn() && (
          getGameData().organizerId == request.auth.uid ||
          (
            'organizer' in getGameData() &&
            ('id' in getGameData().organizer) &&
            getGameData().organizer.id == request.auth.uid
          ) ||
          request.auth.uid == inviteeUserId ||
          isAdmin()
        );
      }

      // Real-time Game Chat Messages Subcollection (/games/{gameId}/messages/{messageId})
      match /messages/{messageId} {
        function isParticipant() {
          let gameDoc = get(/databases/$(database)/documents/games/$(gameId)).data;
          return isSignedIn() && (
            isAdmin() ||
            (('organizerId' in gameDoc) && gameDoc.organizerId == request.auth.uid) ||
            (('organizer' in gameDoc) && ('id' in gameDoc.organizer) && gameDoc.organizer.id == request.auth.uid) ||
            (('participantIds' in gameDoc) && request.auth.uid in gameDoc.participantIds)
          );
        }

        allow read: if isParticipant();
        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.gameId == gameId
          && request.resource.data.text is string 
          && request.resource.data.text.size() > 0 
          && request.resource.data.text.size() <= 2000
          && request.resource.data.senderName is string;
        allow update, delete: if isAdmin();
      }

      // Game Payments Subcollection (/games/{gameId}/payments/{paymentUserId})
      // Scalable provider-agnostic structure: 1 payment doc per participant. Doc ID is paymentUserId.
      match /payments/{paymentUserId} {
        function getGameData() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }

        function isGameOrganizer() {
          let g = getGameData();
          return isSignedIn() && (
            (('organizerId' in g) && g.organizerId == request.auth.uid) ||
            (('organizer' in g) && ('id' in g.organizer) && g.organizer.id == request.auth.uid)
          );
        }

        // Read: The participant themselves, the game organizer, or an admin
        allow read: if isSignedIn() && (
          request.auth.uid == paymentUserId ||
          isGameOrganizer() ||
          isAdmin()
        );

        // Create:
        // Initialized when joining. Status must be 'unpaid' (or 'paid' if free match).
        // Amount must correspond to the authoritative price.
        // User cannot claim provider transaction details at creation.
        allow create: if isSignedIn() && (
          isAdmin() ||
          (
            request.auth.uid == paymentUserId &&
            isValidId(paymentUserId) &&
            request.resource.data.id == paymentUserId &&
            request.resource.data.userId == paymentUserId &&
            request.resource.data.gameId == gameId &&
            request.resource.data.currency == 'KWD' &&
            // Amount must correspond to authoritative game price
            (
              request.resource.data.amountKWD == (
                'pricePerPlayerKWD' in getGameData() 
                  ? getGameData().pricePerPlayerKWD 
                  : ('pricePerPlayer' in getGameData() ? getGameData().pricePerPlayer : 0)
              )
            ) &&
            // Initial status must be unpaid (or paid if free game)
            (
              (request.resource.data.amountKWD > 0 && request.resource.data.status == 'unpaid') ||
              (request.resource.data.amountKWD == 0 && request.resource.data.status == 'paid')
            ) &&
            // Cannot claim provider transaction details at creation
            (!('providerPaymentId' in request.resource.data)) &&
            (!('providerTransactionId' in request.resource.data)) &&
            (!('paidAt' in request.resource.data)) &&
            (!('refundedAt' in request.resource.data)) &&
            request.resource.data.createdAt is string
          )
        );

        // Update:
        // Client players cannot arbitrarily mark themselves 'paid' or 'refunded'.
        // Admins can execute simulated payment / simulated refund transitions.
        // Normal players can only transition:
        // unpaid -> pending, unpaid -> cancelled, pending -> failed, pending -> cancelled, failed -> pending, cancelled -> pending.
        allow update: if isSignedIn() && (
          isAdmin() ||
          (
            request.auth.uid == paymentUserId &&
            // Core payment terms are strictly immutable
            request.resource.data.id == resource.data.id &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.gameId == resource.data.gameId &&
            request.resource.data.organizerId == resource.data.organizerId &&
            request.resource.data.amountKWD == resource.data.amountKWD &&
            request.resource.data.currency == resource.data.currency &&
            request.resource.data.createdAt == resource.data.createdAt &&
            // Only allowed state transitions for the player:
            // Cannot transition to 'paid' or 'refunded' (requires admin/simulation or trusted backend)
            (
              (resource.data.status == 'unpaid' && request.resource.data.status in ['pending', 'cancelled']) ||
              (resource.data.status == 'pending' && request.resource.data.status in ['failed', 'cancelled']) ||
              (resource.data.status == 'failed' && request.resource.data.status in ['pending']) ||
              (resource.data.status == 'cancelled' && request.resource.data.status in ['pending'])
            ) &&
            // Cannot fabricate provider confirmation IDs
            (!('providerPaymentId' in request.resource.data) || request.resource.data.providerPaymentId == resource.data.providerPaymentId) &&
            (!('providerTransactionId' in request.resource.data) || request.resource.data.providerTransactionId == resource.data.providerTransactionId) &&
            (!('paidAt' in request.resource.data) || request.resource.data.paidAt == resource.data.paidAt) &&
            (!('refundedAt' in request.resource.data) || request.resource.data.refundedAt == resource.data.refundedAt)
          )
        );

        allow delete: if isAdmin();
      }

      // Payment Link Requests Subcollection (/games/{gameId}/paymentLinkRequests/{requesterUserId})
      match /paymentLinkRequests/{requesterUserId} {
        function getGameData() {
          return get(/databases/$(database)/documents/games/$(gameId)).data;
        }

        function isGameOrganizer() {
          let g = getGameData();
          return isSignedIn() && (
            (('organizerId' in g) && g.organizerId == request.auth.uid) ||
            (('organizer' in g) && ('id' in g.organizer) && g.organizer.id == request.auth.uid)
          );
        }

        // Read: Requester, Organizer, or Admin
        allow read: if isSignedIn() && (
          request.auth.uid == requesterUserId ||
          isGameOrganizer() ||
          isAdmin()
        );

        // Create: Authorized participant can request a link (requester cannot be the organizer)
        allow create: if isSignedIn()
          && isValidId(requesterUserId)
          && request.auth.uid == requesterUserId
          && request.resource.data.requesterId == requesterUserId
          && request.resource.data.gameId == gameId
          && request.resource.data.status == 'pending'
          && !isGameOrganizer()
          && (
            request.auth.uid in getGameData().participantIds ||
            ('participants' in getGameData())
          );

        // Update: Only the host or Admin can mark as handled or provide link
        allow update: if isSignedIn() && (
          isGameOrganizer() ||
          isAdmin()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handledAt', 'paymentLinkUrl', 'updatedAt'])
        && request.resource.data.status in ['pending', 'handled'];

        // Delete: Requester, Host, or Admin
        allow delete: if isSignedIn() && (
          request.auth.uid == requesterUserId ||
          isGameOrganizer() ||
          isAdmin()
        );
      }
    }

    // Game Participants Collection
    match /gameParticipants/{participantId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.gameId is string;
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        // Organizer can update attendance
        get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.organizerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.organizerId == request.auth.uid
      );
    }

    // Courts Collection (Public read, Admin/Facility write)
    match /courts/{courtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Court Bookings Collection
    match /courtBookings/{bookingId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.organizerId == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.organizerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (resource.data.organizerId == request.auth.uid && request.resource.data.organizerId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Chat Messages Collection
    match /chatMessages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (isAdmin() || resource.data.senderId == request.auth.uid);
    }

    // Notifications Collection (Strict privacy: user only)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() 
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Reports Collection (Community safety and moderation)
    match /reports/{reportId} {
      // Read: Admins can review all reports in the moderation queue.
      // Authenticated users can fetch their own report document to verify status and duplicate protection.
      allow get: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      // Moderation queue and listing remain strictly admin-only
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(reportId)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason in [
          'spam', 
          'harassment', 
          'inappropriate_behavior', 
          'fake_profile', 
          'scam_or_fraud', 
          'unsafe_behavior', 
          'other'
        ]
        && (
          (('reportedUserId' in request.resource.data) && isValidId(request.resource.data.reportedUserId) && request.resource.data.reportedUserId != request.auth.uid && request.resource.data.reportedUserId != 'user-current') ||
          (('reportedGameId' in request.resource.data) && isValidId(request.resource.data.reportedGameId))
        )
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 1000))
        && (!('id' in request.resource.data) || request.resource.data.id == reportId)
        && request.resource.data.createdAt is string;
      
      // Update: strictly authorized admin/moderator only
      // Reporter identity and reported targets are strictly immutable
      // Valid status transitions only:
      // open -> reviewing | resolved | dismissed
      // reviewing -> resolved | dismissed
      allow update: if isAdmin()
        && request.resource.data.reporterId == resource.data.reporterId
        && (!('reportedUserId' in resource.data) || request.resource.data.reportedUserId == resource.data.reportedUserId)
        && (!('reportedGameId' in resource.data) || request.resource.data.reportedGameId == resource.data.reportedGameId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.moderatorId == request.auth.uid
        && (
          (resource.data.status == 'open' && request.resource.data.status in ['reviewing', 'resolved', 'dismissed']) ||
          (resource.data.status == 'reviewing' && request.resource.data.status in ['resolved', 'dismissed'])
        );

      allow delete: if isAdmin();
    }

    // Moderation Audit Logs Collection (/moderationLogs/{logId})
    // Append-only audit trail: readable and creatable only by authorized admins.
    // Immutable once written: update and delete are strictly forbidden.
    match /moderationLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.moderatorId == request.auth.uid
        && request.resource.data.action in ['review_report', 'resolve_report', 'dismiss_report', 'cancel_game', 'disable_game']
        && request.resource.data.targetType in ['user', 'game', 'report']
        && isValidId(request.resource.data.targetId)
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Collection Group Queries for Outgoing Friend Requests
    match /{path=**}/friendRequests/{requesterUserId} {
      allow read: if isSignedIn() && (
        request.auth.uid == requesterUserId ||
        (resource != null && 'recipientId' in resource.data && resource.data.recipientId == request.auth.uid) ||
        isAdmin()
      );
    }

    // Collection Group Queries for Incoming Game Invites
    match /{path=**}/invites/{inviteeUserId} {
      allow read: if isSignedIn() && (
        request.auth.uid == inviteeUserId ||
        (resource != null && 'inviterId' in resource.data && resource.data.inviterId == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
